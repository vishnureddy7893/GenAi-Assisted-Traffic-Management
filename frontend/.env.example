# Frontend environment template. Copy to `.env.local` (git-ignored) to override.
#
# Base URL for the backend API.
# Leave EMPTY in development: vite.config.ts proxies /api to the backend, so the
# browser makes same-origin requests and CORS is not involved at all.
# Set an absolute origin (e.g. https://api.example.org) only when the frontend is
# served from a different host than the API.
VITE_API_BASE_URL=

# Milliseconds before an API request is abandoned. A hung request must surface as
# an explicit error state, never as a panel that renders empty and looks like
# "no traffic".
VITE_API_TIMEOUT_MS=10000
