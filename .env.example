# ===========================================================================
# GenAI-Assisted Traffic Management System — environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in locally.  NEVER commit `.env`.
#   cp .env.example .env
# Every value below is read through backend/app/core/config.py (pydantic-settings).
# Secrets are typed as SecretStr and are redacted in logs and in /api/meta/*.
# ===========================================================================

# --- Application ----------------------------------------------------------
# app_env: local | ci | staging | production
APP_ENV=local
APP_DEBUG=true

# --- API server -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed browser origins for CORS.
# The Vite dev server defaults to 5173.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging --------------------------------------------------------------
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# log_format: json (machine-readable, use in CI/staging/prod) | console (human-readable)
LOG_FORMAT=console

# --- Data locations -------------------------------------------------------
# Large corpora live outside Git. These may point anywhere on the local disk.
DATASETS_DIR=./datasets
MODELS_DIR=./models

# Surveyed observation site locations, persisted as JSON. Deliberately outside
# the media directory: a site records where a junction is, and clearing ingested
# media must not discard a survey that is expensive to repeat and easy to guess
# wrongly. Never reachable from client input — configuration only.
SITES_FILE=./datasets/sites/observation-sites.json

# Human-confirmed site-to-junction bindings. A separate file from SITES_FILE on
# purpose: a confirmation is a decision *about* a site, so correcting a
# coordinate must not rewrite the decision made against the old one.
CONFIRMED_BINDINGS_FILE=./datasets/sites/confirmed-bindings.json

# Range within which proximity to a junction counts as evidence for a binding.
# Not a threshold for creating one — nothing is ever bound without a human —
# but for whether a nearest-junction result is offered as a candidate at all.
# Beyond it the likeliest explanations are a mistyped coordinate or a junction
# that is not on this map, and the distance is reported instead.
SITE_BINDING_MAX_DISTANCE_M=250.0

# --- Traffic state assembly (safety-relevant) -----------------------------
# Maximum age of a JunctionObservation before it may still be folded into a
# NetworkState. Beyond this the junction is marked STALE and any decision that
# depends on it is downgraded. See docs/adr/0005-observation-staleness.md.
MAX_OBSERVATION_STALENESS_S=5.0
# Beyond this age the observation is dropped entirely (junction becomes UNKNOWN).
DROP_OBSERVATION_AFTER_S=30.0

# --- Safety rule catalog --------------------------------------------------
# Pinned version of the safety rule catalog used to evaluate constraints.
# Recorded into every decision record for auditability.
SAFETY_RULES_VERSION=0.1.0

# --- Route cost weights ---------------------------------------------------
# Pinned version of the route cost weight set (all penalties in equivalent seconds).
ROUTE_WEIGHTS_VERSION=0.1.0

# ===========================================================================
# NOT USED IN PHASE 1 — reserved so that configuration does not change shape
# later. Leave blank until the corresponding phase is implemented.
# ===========================================================================

# --- GenAI / AI Traffic Advisor -------------------------------------------
# Pretrained LLM accessed via OpenRouter. Never commit a real key.
# Obtain from https://openrouter.ai/keys
#
# Leaving these blank is a SUPPORTED configuration, not a broken one. With no
# key the AI Traffic Advisor composes its advisory from the recorded facts by
# fixed rules and labels the result "deterministic_fallback"; it never presents
# template text as a model's work. See
# docs/adr/0017-llm-is-an-advisory-layer-over-deterministic-facts.md
#
# The key is read server-side only. It is never returned by any endpoint and
# never reaches the browser; a test asserts both.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id, e.g. anthropic/claude-3.5-haiku
OPENROUTER_MODEL=
# Hard ceiling on generation cost/latency; enforced client-side.
# A timeout falls back to the deterministic advisory rather than failing.
OPENROUTER_TIMEOUT_S=30
OPENROUTER_MAX_TOKENS=2048

# --- Live traffic ingestion (Phase 14) ------------------------------------
# Example: rtsp://user:pass@host:554/stream  (credentials belong in .env only)
LIVE_SOURCE_URI=
LIVE_SOURCE_TARGET_FPS=10
# Backpressure policy for unbounded sources: drop_oldest | drop_newest | block
LIVE_SOURCE_DROP_POLICY=drop_oldest
LIVE_SOURCE_MAX_QUEUE_FRAMES=60
